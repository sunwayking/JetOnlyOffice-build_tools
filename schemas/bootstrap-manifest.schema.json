{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jetonlyoffice.dev/schemas/bootstrap-manifest.schema.json",
  "title": "JetOnlyOffice bootstrap manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestType",
    "platform",
    "sourceLockSha256",
    "toolchainLockSha256",
    "imageLockSha256",
    "sourceDateEpoch",
    "environment",
    "network",
    "toolchainFiles",
    "images"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "manifestType": {
      "const": "bootstrap"
    },
    "platform": {
      "const": "linux-amd64"
    },
    "sourceLockSha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "toolchainLockSha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "imageLockSha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "sourceDateEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "environment": {
      "$ref": "common.schema.json#/$defs/environment"
    },
    "network": {
      "const": "online-only"
    },
    "toolchainFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/repositoryId"
          },
          "path": {
            "$ref": "common.schema.json#/$defs/relativePath"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "reference",
          "digest",
          "configDigest"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/repositoryId"
          },
          "role": {
            "enum": [
              "builder",
              "runtime",
              "buildkit",
              "dockerfile-frontend"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "$ref": "common.schema.json#/$defs/ociDigest"
          },
          "configDigest": {
            "$ref": "common.schema.json#/$defs/ociDigest"
          }
        }
      }
    }
  }
}
