{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jetonlyoffice.dev/schemas/build-manifest.schema.json",
  "title": "JetOnlyOffice build manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestType",
    "buildId",
    "platform",
    "configuration",
    "sourceLockSha256",
    "toolchainLockSha256",
    "imageLockSha256",
    "builderImageDigest",
    "sourceDateEpoch",
    "environment",
    "network",
    "packageDriver",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "manifestType": {
      "const": "build"
    },
    "buildId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "platform": {
      "const": "linux-amd64"
    },
    "configuration": {
      "const": "Release"
    },
    "sourceLockSha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "toolchainLockSha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "imageLockSha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "builderImageDigest": {
      "$ref": "common.schema.json#/$defs/ociDigest"
    },
    "sourceDateEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "environment": {
      "$ref": "common.schema.json#/$defs/environment"
    },
    "network": {
      "const": "none"
    },
    "packageDriver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path",
        "mode",
        "size",
        "sha256"
      ],
      "properties": {
        "type": {
          "const": "file"
        },
        "path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "mode": {
          "type": "string",
          "pattern": "^[0-7]{4}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/buildFileRecord"
      }
    }
  }
}
