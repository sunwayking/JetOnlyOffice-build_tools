{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jetonlyoffice.dev/schemas/common.schema.json",
  "title": "JetOnlyOffice shared contract definitions",
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ociDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "repositoryId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "editor": {
      "enum": [
        "word",
        "spreadsheet",
        "presentation",
        "pdf"
      ]
    },
    "permissionProfile": {
      "enum": [
        "edit",
        "review",
        "comment",
        "fillForms",
        "view"
      ]
    },
    "gateCategory": {
      "enum": [
        "source",
        "build",
        "artifact",
        "command",
        "functional",
        "permission",
        "collaboration",
        "resilience",
        "browser",
        "android",
        "tablet",
        "ios",
        "accessibility",
        "privacy",
        "performance",
        "reproducibility"
      ]
    },
    "gateStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "INFRA_INCOMPLETE"
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\).+$"
    },
    "httpsUri": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "declaredLicense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "blob",
        "sha256",
        "spdx"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "blob": {
          "$ref": "#/$defs/sha1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "spdx": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "componentLicenseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path",
        "blob",
        "sha256",
        "locator",
        "evidenceSha256"
      ],
      "properties": {
        "type": {
          "enum": [
            "font-name",
            "git-blob",
            "zip-member"
          ]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "blob": {
          "$ref": "#/$defs/sha1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "evidenceSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "componentLicenseRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx",
        "evidence"
      ],
      "properties": {
        "spdx": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/componentLicenseEvidence"
          }
        }
      }
    },
    "componentScopedLicense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "payloadPatterns",
        "components"
      ],
      "properties": {
        "scope": {
          "const": "component"
        },
        "payloadPatterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "payloadPaths",
              "license"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "payloadPaths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/relativePath"
                }
              },
              "license": {
                "$ref": "#/$defs/componentLicenseRecord"
              }
            }
          }
        }
      }
    },
    "license": {
      "oneOf": [
        {
          "$ref": "#/$defs/declaredLicense"
        },
        {
          "$ref": "#/$defs/componentScopedLicense"
        }
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "locale",
        "umask",
        "pythonHashSeed",
        "buildPath",
        "concurrency"
      ],
      "properties": {
        "timezone": {
          "const": "UTC"
        },
        "locale": {
          "const": "C.UTF-8"
        },
        "umask": {
          "const": "022"
        },
        "pythonHashSeed": {
          "const": "0"
        },
        "buildPath": {
          "const": "/work"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mode",
        "size",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "mode": {
          "type": "string",
          "pattern": "^[0-7]{4}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "$ref": "#/$defs/repositoryId"
        }
      }
    },
    "buildFileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path",
        "mode",
        "size",
        "sha256"
      ],
      "properties": {
        "type": {
          "enum": [
            "file",
            "symlink"
          ]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "mode": {
          "type": "string",
          "pattern": "^[0-7]{4}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "$ref": "#/$defs/repositoryId"
        },
        "symlinkTarget": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
