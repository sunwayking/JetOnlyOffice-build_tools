{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jetonlyoffice.dev/schemas/common.schema.json",
  "title": "JetOnlyOffice shared contract definitions",
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ociDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "repositoryId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\).+$"
    },
    "httpsUri": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "blob",
        "sha256",
        "spdx"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "blob": {
          "$ref": "#/$defs/sha1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "spdx": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "locale",
        "umask",
        "pythonHashSeed",
        "buildPath",
        "concurrency"
      ],
      "properties": {
        "timezone": {
          "const": "UTC"
        },
        "locale": {
          "const": "C.UTF-8"
        },
        "umask": {
          "const": "022"
        },
        "pythonHashSeed": {
          "const": "0"
        },
        "buildPath": {
          "const": "/work"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mode",
        "size",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "mode": {
          "type": "string",
          "pattern": "^[0-7]{4}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "$ref": "#/$defs/repositoryId"
        }
      }
    }
  }
}
