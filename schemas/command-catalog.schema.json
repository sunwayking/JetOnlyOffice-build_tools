{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jetonlyoffice.dev/schemas/command-catalog.schema.json",
  "title": "JetOnlyOffice command coverage catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogType",
    "productVersion",
    "editor",
    "sourceCommit",
    "inventorySha256",
    "inventoryCount",
    "commands"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalogType": {
      "const": "command"
    },
    "productVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "editor": {
      "$ref": "common.schema.json#/$defs/editor"
    },
    "sourceCommit": {
      "$ref": "common.schema.json#/$defs/sha1"
    },
    "inventorySha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "inventoryCount": {
      "type": "integer",
      "minimum": 1
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "disposition",
          "desktop",
          "contexts",
          "permissions",
          "tests"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/repositoryId"
          },
          "disposition": {
            "enum": [
              "mapped",
              "excluded"
            ]
          },
          "desktop": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "symbol"
            ],
            "properties": {
              "path": {
                "$ref": "common.schema.json#/$defs/relativePath"
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "contexts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "permissions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/permissionProfile"
            }
          },
          "mobile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "entrypoints"
            ],
            "properties": {
              "provider": {
                "enum": [
                  "word",
                  "spreadsheet",
                  "presentation",
                  "pdf",
                  "common"
                ]
              },
              "entrypoints": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "adr": {
            "$ref": "common.schema.json#/$defs/relativePath"
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
