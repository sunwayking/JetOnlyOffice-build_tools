{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jetonlyoffice.dev/schemas/source-license-audit.schema.json",
  "title": "JetOnlyOffice source license inventory audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "auditType", "productVersion", "status", "repositories"],
  "properties": {
    "schemaVersion": {"const": 1},
    "auditType": {"const": "source-license-inventory"},
    "productVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "status": {"enum": ["passed", "failed"]},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "commit", "tree", "status", "components"],
        "properties": {
          "repository": {"$ref": "common.schema.json#/$defs/repositoryId"},
          "commit": {"$ref": "common.schema.json#/$defs/sha1"},
          "tree": {"$ref": "common.schema.json#/$defs/sha1"},
          "status": {"enum": ["complete", "incomplete"]},
          "components": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "status", "payloadPaths", "candidateEvidence"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "status": {"enum": ["blocked", "resolved", "review-required", "unresolved"]},
                "payloadPaths": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"$ref": "common.schema.json#/$defs/relativePath"}
                },
                "candidateEvidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "blob", "sha256"],
                    "properties": {
                      "path": {"$ref": "common.schema.json#/$defs/relativePath"},
                      "blob": {"$ref": "common.schema.json#/$defs/sha1"},
                      "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
                    }
                  }
                },
                "blockingReview": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["code", "reason", "evidence"],
                  "properties": {
                    "code": {
                      "enum": [
                        "AMBIGUOUS_CHOICE",
                        "AMBIGUOUS_VERSION",
                        "CONFLICTING_TERMS",
                        "INCOMPLETE_SCOPE",
                        "MISSING_EVIDENCE"
                      ]
                    },
                    "reason": {"type": "string", "minLength": 1},
                    "evidence": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["path", "blob", "sha256"],
                        "properties": {
                          "path": {"$ref": "common.schema.json#/$defs/relativePath"},
                          "blob": {"$ref": "common.schema.json#/$defs/sha1"},
                          "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
                        }
                      }
                    }
                  }
                },
                "license": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["spdx", "evidence"],
                  "properties": {
                    "spdx": {"type": "string", "minLength": 1},
                    "evidence": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "path",
                          "blob",
                          "sha256",
                          "locator",
                          "evidenceSha256"
                        ],
                        "properties": {
                          "type": {"enum": ["font-name", "git-blob", "zip-member"]},
                          "path": {"$ref": "common.schema.json#/$defs/relativePath"},
                          "blob": {"$ref": "common.schema.json#/$defs/sha1"},
                          "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
                          "locator": {"type": "string", "minLength": 1},
                          "evidenceSha256": {"$ref": "common.schema.json#/$defs/sha256"}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
