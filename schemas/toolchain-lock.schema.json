{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jetonlyoffice.dev/schemas/toolchain-lock.schema.json",
  "title": "JetOnlyOffice toolchain lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lockType",
    "platform",
    "sourceDateEpoch",
    "environment",
    "tools"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "lockType": {
      "const": "toolchain"
    },
    "platform": {
      "const": "linux-amd64"
    },
    "sourceDateEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "environment": {
      "$ref": "common.schema.json#/$defs/environment"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "version",
          "kind",
          "platform",
          "sourceUrl",
          "sha256",
          "size"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/repositoryId"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "apt",
              "npm",
              "pkg",
              "python",
              "qt",
              "sysroot",
              "binary",
              "source"
            ]
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "$ref": "common.schema.json#/$defs/httpsUri"
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
