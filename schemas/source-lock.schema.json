{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jetonlyoffice.dev/schemas/source-lock.schema.json",
  "title": "JetOnlyOffice source lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lockType",
    "productVersion",
    "baseline",
    "sourceDateEpoch",
    "repositories",
    "relationships"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "lockType": {
      "const": "source"
    },
    "productVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "$ref": "common.schema.json#/$defs/repositoryId"
        },
        "commit": {
          "$ref": "common.schema.json#/$defs/sha1"
        }
      }
    },
    "sourceDateEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "checkoutPath",
          "origin",
          "upstream",
          "commit",
          "tree",
          "commitTime",
          "projectFork",
          "buildInput",
          "active",
          "lfsObjects",
          "license"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/repositoryId"
          },
          "role": {
            "enum": [
              "product-fork",
              "superproject",
              "gitlink",
              "auxiliary-mirror",
              "build-input",
              "package-input",
              "toolchain-source"
            ]
          },
          "checkoutPath": {
            "$ref": "common.schema.json#/$defs/relativePath"
          },
          "origin": {
            "$ref": "common.schema.json#/$defs/httpsUri"
          },
          "upstream": {
            "$ref": "common.schema.json#/$defs/httpsUri"
          },
          "commit": {
            "$ref": "common.schema.json#/$defs/sha1"
          },
          "tree": {
            "$ref": "common.schema.json#/$defs/sha1"
          },
          "commitTime": {
            "type": "integer",
            "minimum": 1
          },
          "refHint": {
            "type": "string",
            "minLength": 1
          },
          "projectFork": {
            "type": "boolean"
          },
          "buildInput": {
            "type": "boolean"
          },
          "active": {
            "type": "boolean"
          },
          "lfsObjects": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "oid",
                "size",
                "paths"
              ],
              "properties": {
                "oid": {
                  "$ref": "common.schema.json#/$defs/sha256"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0
                },
                "paths": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "common.schema.json#/$defs/relativePath"
                  }
                }
              }
            }
          },
          "license": {
            "$ref": "common.schema.json#/$defs/license"
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parent",
          "child",
          "path",
          "mode"
        ],
        "properties": {
          "parent": {
            "$ref": "common.schema.json#/$defs/repositoryId"
          },
          "child": {
            "$ref": "common.schema.json#/$defs/repositoryId"
          },
          "path": {
            "$ref": "common.schema.json#/$defs/relativePath"
          },
          "mode": {
            "const": "160000"
          }
        }
      }
    }
  }
}
