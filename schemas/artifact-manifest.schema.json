{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jetonlyoffice.dev/schemas/artifact-manifest.schema.json",
  "title": "JetOnlyOffice artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestType",
    "releaseId",
    "productVersion",
    "platform",
    "sourceLockSha256",
    "buildManifestSha256",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "manifestType": {
      "const": "artifact"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "productVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "platform": {
      "const": "linux-amd64"
    },
    "sourceLockSha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "buildManifestSha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "path",
          "size",
          "sha256",
          "mediaType",
          "subjects"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/repositoryId"
          },
          "type": {
            "enum": [
              "deb",
              "rootfs",
              "oci",
              "source",
              "spdx",
              "cyclonedx",
              "provenance",
              "checksums",
              "diffoscope"
            ]
          },
          "path": {
            "$ref": "common.schema.json#/$defs/relativePath"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          },
          "subjects": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/repositoryId"
            }
          }
        }
      }
    }
  }
}
